// Version info and icon of havihub-windows.exe (shown in Task Manager)
#include <winver.h>

1 ICON "../icon.ico"

1 VERSIONINFO
FILEVERSION 1,3,0,0
PRODUCTVERSION 1,3,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Havi Hub"
      VALUE "FileDescription", "Havi Hub - ventanas del motor"
      VALUE "FileVersion", "1.3.0"
      VALUE "InternalName", "havihub-windows"
      VALUE "OriginalFilename", "havihub-windows.exe"
      VALUE "ProductName", "Havi Hub"
      VALUE "ProductVersion", "1.3.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
